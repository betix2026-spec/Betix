# =============================================================================
# BETIX — Backend environment variables
# Copy this file to .env and fill in the values
# =============================================================================

# --- App ---
APP_NAME=BETIX API
APP_VERSION=0.1.0
DEBUG=true

# --- CORS ---
FRONTEND_URL=http://localhost:3000

# --- API-Sports (Football + Basketball) ---
# Sign up: https://dashboard.api-football.com/register
API_SPORTS_KEY=

# --- API-Tennis ---
# Sign up: https://api-tennis.com
API_TENNIS_KEY=

# --- Gemini (AI) ---
# Console: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Supabase ---
# Dashboard: https://supabase.com/dashboard
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
# Dashboard: https://dashboard.stripe.com
STRIPE_SECRET_KEY=

# --- Internal secrets ---
# Shared secret checked on endpoints only the server-side frontend should
# call (e.g. the on-demand AI generation trigger). Any long random string.
INTERNAL_API_SECRET=

# Shared secret checked on endpoints called by a Supabase Database Webhook
# (e.g. the new-user -> EmailOctopus sync). Set the same value as a custom
# header (X-Webhook-Secret) on the webhook config in the Supabase dashboard.
SUPABASE_WEBHOOK_SECRET=

# --- EmailOctopus ---
# API key: https://emailoctopus.com/account/api-keys
# List ID: EmailOctopus dashboard -> your list -> Settings
EMAILOCTOPUS_API_KEY=
EMAILOCTOPUS_LIST_ID=
